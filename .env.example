# Copy to .env (never commit .env). Generate JWT_SECRET with:  openssl rand -base64 48
DB_URL=jdbc:mysql://localhost:3306/ledgerline_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=change-me
JWT_SECRET=change-me-base64-at-least-32-bytes
JWT_EXPIRATION_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:5173
SEED_ENABLED=true
SEED_PASSWORD=change-me-too
