FROM maven:3.9-eclipse-temurin-23 AS build
WORKDIR /app
COPY pom.xml .
RUN mvn -q -B dependency:go-offline
COPY src ./src
RUN mvn -q -B -DskipTests package

FROM eclipse-temurin:23-jre
WORKDIR /app
COPY --from=build /app/target/ledgerline-0.1.0.jar app.jar
EXPOSE 8080
# DB_URL, DB_USER, DB_PASSWORD, JWT_SECRET, CORS_ALLOWED_ORIGINS are supplied as environment variables at runtime.
ENTRYPOINT ["java", "-jar", "app.jar"]
